rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────────────────

    function isCoach() {
      return get(/databases/$(database)/documents/userMappings/$(request.auth.uid)).data.role == 'coach';
    }

    function clientId() {
      return get(/databases/$(database)/documents/userMappings/$(request.auth.uid)).data.clientId;
    }

    // ─── User Mappings ──────────────────────────────────────────────────────
    // FIXED: Clients can NO LONGER write their own mapping.
    // Previously: allow write: if request.auth != null && (isCoach() || request.auth.uid == uid)
    // This allowed a client to escalate their own role to 'coach' or change their clientId.
    match /userMappings/{uid} {
      allow read: if request.auth != null && (request.auth.uid == uid || isCoach());
      allow write: if request.auth != null && isCoach();
    }

    // ─── Clients ────────────────────────────────────────────────────────────
    match /clients/{docClientId} {
      allow read: if request.auth != null && (isCoach() || clientId() == docClientId);
      allow write: if request.auth != null && isCoach();
    }

    // ─── Workout Plans ──────────────────────────────────────────────────────
    match /workoutPlans/{docClientId} {
      allow read: if request.auth != null && (isCoach() || clientId() == docClientId);
      allow write: if request.auth != null && isCoach();
    }

    // ─── Nutrition Plans ────────────────────────────────────────────────────
    match /nutritionPlans/{docClientId} {
      allow read: if request.auth != null && (isCoach() || clientId() == docClientId);
      allow write: if request.auth != null && isCoach();
    }

    // ─── Workout Logs ───────────────────────────────────────────────────────
    match /workoutLogs/{logId} {
      // read: coach sees all; client sees only their own (resource.data exists)
      allow read: if request.auth != null && (isCoach() || resource.data.clientId == clientId());
      // create: on new doc, resource is null — use request.resource instead
      allow create: if request.auth != null && (isCoach() || request.resource.data.clientId == clientId());
      // update: document already exists, both resource and request.resource are available
      allow update: if request.auth != null && (isCoach() || resource.data.clientId == clientId());
      allow delete: if request.auth != null && isCoach();
    }

    // ─── Check-ins ──────────────────────────────────────────────────────────
    // FIXED: Replaced ambiguous `write` with explicit `update, delete` for coach.
    // Clients can only CREATE their own check-ins (not update/delete).
    match /checkIns/{checkInId} {
      allow read: if request.auth != null && (isCoach() || resource.data.clientId == clientId());
      allow create: if request.auth != null && request.resource.data.clientId == clientId();
      allow update, delete: if request.auth != null && isCoach();
    }

    // ─── FCM Tokens ─────────────────────────────────────────────────────────
    // Users manage their own tokens; coach can read all to send push notifications.
    match /fcmTokens/{tokenId} {
      allow read: if request.auth != null && (resource.data.uid == request.auth.uid || isCoach());
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && (resource.data.uid == request.auth.uid || isCoach());
    }

    // ─── Notifications ───────────────────────────────────────────────────────
    // FIXED: `allow create` was `request.auth != null` (any user → any target).
    // Now: clients can only create notifications for themselves; coach can create for anyone.
    match /notifications/{notifId} {
      allow read: if request.auth != null && (resource.data.userId == request.auth.uid || isCoach());
      allow update: if request.auth != null && (resource.data.userId == request.auth.uid || isCoach());
      allow create: if request.auth != null && (
        isCoach() ||
        request.resource.data.userId == request.auth.uid
      );
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isCoach());
    }

    // ─── Notification Preferences ────────────────────────────────────────────
    match /notificationPreferences/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      allow read, delete: if request.auth != null && isCoach();
    }
  }
}
