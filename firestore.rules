rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Coach can read/write everything
    // Client can only read/write their own data

    function isCoach() {
      return get(/databases/$(database)/documents/userMappings/$(request.auth.uid)).data.role == 'coach';
    }

    function clientId() {
      return get(/databases/$(database)/documents/userMappings/$(request.auth.uid)).data.clientId;
    }

    // User mappings — authenticated users can read their own
    match /userMappings/{uid} {
      allow read: if request.auth != null && request.auth.uid == uid;
      allow write: if request.auth != null && isCoach();
    }

    // Clients
    match /clients/{clientId} {
      allow read: if request.auth != null && (isCoach() || clientId() == clientId);
      allow write: if request.auth != null && isCoach();
    }

    // Workout plans
    match /workoutPlans/{clientId} {
      allow read: if request.auth != null && (isCoach() || clientId() == clientId);
      allow write: if request.auth != null && isCoach();
    }

    // Nutrition plans
    match /nutritionPlans/{clientId} {
      allow read: if request.auth != null && (isCoach() || clientId() == clientId);
      allow write: if request.auth != null && isCoach();
    }

    // Check-ins — clients can write their own, coach reads all
    match /checkIns/{checkInId} {
      allow read: if request.auth != null && (isCoach() || resource.data.clientId == clientId());
      allow create: if request.auth != null && request.resource.data.clientId == clientId();
      allow write: if request.auth != null && isCoach();
    }

    // ─── Notifications ──────────────────────────────────────────────────

    // FCM device tokens — users can manage their own tokens
    match /fcmTokens/{tokenId} {
      allow read: if request.auth != null && resource.data.uid == request.auth.uid;
      allow create, update: if request.auth != null && request.resource.data.uid == request.auth.uid;
      allow delete: if request.auth != null && resource.data.uid == request.auth.uid;
      // Coach can read all tokens (needed to send push notifications)
      allow read: if request.auth != null && isCoach();
    }

    // Notifications — users can read/update their own, coach can create for anyone
    match /notifications/{notifId} {
      allow read: if request.auth != null && resource.data.userId == request.auth.uid;
      allow update: if request.auth != null && resource.data.userId == request.auth.uid;
      allow create: if request.auth != null;
      allow delete: if request.auth != null && (resource.data.userId == request.auth.uid || isCoach());
      // Coach can read all notifications
      allow read: if request.auth != null && isCoach();
    }

    // Notification preferences — users can read/write their own
    match /notificationPreferences/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
      // Coach can read all preferences
      allow read: if request.auth != null && isCoach();
    }
  }
}
